# --- Required for production ---
AUTH_SECRET=            # random string, 16+ chars; signs login cookies
ADMIN_PASSWORD=         # first login only: user "admin" with this password creates the admin account
# --- LINE Messaging API (without these, messages are queued but reported as "ไม่ได้ส่ง") ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=    # verifies /api/line/webhook signatures
LINE_ADMIN_USER_ID=     # LINE user id that receives admin alerts
# --- Scheduler ---
CRON_SECRET=            # GET /api/notifications/dispatch with "Authorization: Bearer <CRON_SECRET>"
# --- Storage (REQUIRED on Vercel; leave empty locally to use data/*.json) ---
DATABASE_URL=               # Neon pooled connection string, then run: npm run db:migrate
# (alternative) UPSTASH_REDIS_REST_URL= / UPSTASH_REDIS_REST_TOKEN=
